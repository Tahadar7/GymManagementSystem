@model CategoryViewModel
@{
    ViewData["Title"] = "Delete Category";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow text-center p-4">

                <div class="mb-3" style="font-size:60px;">⚠️</div>
                <h4 class="fw-bold text-danger mb-2">Delete Category</h4>

                <p class="text-muted">
                    Are you sure you want to delete
                    <strong>@Model.CategoryName</strong>?
                </p>

                <div class="alert alert-warning text-start mt-3">
                    <strong>Warning:</strong> This cannot be undone.
                    Deletion is blocked if any sessions are assigned to this category.
                </div>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-3 mt-3">
                        <a asp-controller="Category" asp-action="Index"
                           class="btn btn-outline-secondary flex-fill">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-danger flex-fill">
                            <i class="bi bi-trash me-2"></i>Yes, Delete
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>