@model IEnumerable<CategoryViewModel>
@{
    ViewData["Title"] = "Categories";
}

<div class="container">
    <header class="d-flex justify-content-between align-items-center mt-5 mb-4">
        <h3 class="fw-bold">Categories</h3>
        <a asp-controller="Category" asp-action="Create"
           class="btn btn-primary fw-medium rounded-pill px-4 py-2">
            <i class="bi bi-plus-circle me-2"></i>Add Category
        </a>
    </header>

    @if (Model is not null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-borderless align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Category Name</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.Id</td>
                            <td><strong>@category.CategoryName</strong></td>
                            <td>
                                <a asp-controller="Category" asp-action="Edit"
                                   asp-route-id="@category.Id"
                                   class="btn btn-sm btn-outline-primary me-2">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                                <a asp-controller="Category" asp-action="Delete"
                                   asp-route-id="@category.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash me-1"></i>Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-tag display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Categories Yet</h4>
            <p class="text-muted">Add your first category before creating sessions.</p>
            <a asp-controller="Category" asp-action="Create" class="btn btn-primary mt-2">
                <i class="bi bi-plus-circle me-2"></i>Add Category
            </a>
        </div>
    }
</div>