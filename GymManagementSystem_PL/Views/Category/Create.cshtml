@model CreateCategoryViewModel
@{
    ViewData["Title"] = "Add Category";
}

<div class="container mt-4">
    <header class="mb-4">
        <h3 class="fw-bold">Add Category</h3>
    </header>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow">
                <div class="card-body p-4">

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="CategoryName" class="form-label fw-semibold"></label>
                            <input asp-for="CategoryName" class="form-control"
                                   placeholder="e.g. Cardio, Yoga, Boxing" />
                            <span asp-validation-for="CategoryName" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-controller="Category" asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                <i class="bi bi-arrow-left me-2"></i>Back
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-plus-circle me-2"></i>Add Category
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}