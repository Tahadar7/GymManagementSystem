@model TrainerViewModel
@{
    ViewData["Title"] = "Trainer Details";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">

                <div class="card-header bg-primary text-white text-center py-5">
                    <i class="bi bi-person-badge display-4 mb-3"></i>
                    <h2 class="mb-0">@Model.Name</h2>
                    <span class="badge bg-warning text-dark mt-2">@Model.Specialties</span>
                </div>

                <div class="card-body p-4">
                    <div class="row g-3">

                        <div class="col-12">
                            <div class="d-flex align-items-center p-3 bg-light rounded">
                                <i class="bi bi-envelope text-primary fs-4 me-3"></i>
                                <div>
                                    <h6 class="mb-0 text-muted">Email</h6>
                                    <strong>@Model.Email</strong>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="d-flex align-items-center p-3 bg-light rounded">
                                <i class="bi bi-telephone text-primary fs-4 me-3"></i>
                                <div>
                                    <h6 class="mb-0 text-muted">Phone</h6>
                                    <strong>@Model.Phone</strong>
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="d-flex align-items-center p-3 bg-light rounded">
                                <i class="bi bi-gender-ambiguous text-primary fs-4 me-3"></i>
                                <div>
                                    <h6 class="mb-0 text-muted">Gender</h6>
                                    <strong>@Model.Gender</strong>
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="d-flex align-items-center p-3 bg-light rounded">
                                <i class="bi bi-calendar-date text-primary fs-4 me-3"></i>
                                <div>
                                    <h6 class="mb-0 text-muted">Date of Birth</h6>
                                    <strong>@Model.DateOfBirth</strong>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="d-flex align-items-center p-3 bg-light rounded">
                                <i class="bi bi-geo-alt text-primary fs-4 me-3"></i>
                                <div>
                                    <h6 class="mb-0 text-muted">Address</h6>
                                    <strong>@(Model.Address ?? "No address on record")</strong>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="card-footer bg-white border-0 px-4 pb-4 d-flex gap-2">
                    <a asp-controller="Trainer"
                       asp-action="Index"
                       class="btn btn-outline-secondary flex-fill">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>
                    <a asp-controller="Trainer"
                       asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary flex-fill">
                        <i class="bi bi-pencil me-2"></i>Edit
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>