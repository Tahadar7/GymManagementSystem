@model TrainerViewModel
@{
    ViewData["Title"] = "Delete Trainer";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow text-center p-4">

                <div class="mb-3" style="font-size:60px;">⚠️</div>

                <h4 class="fw-bold text-danger mb-2">Delete Trainer</h4>

                <p class="text-muted mb-1">
                    Are you sure you want to delete
                    <strong>@Model.Name</strong>?
                </p>

                <div class="alert alert-warning text-start mt-3" role="alert">
                    <strong>Warning:</strong> This action cannot be undone.
                    Deletion will be blocked if the trainer has upcoming sessions assigned.
                </div>

                <div class="bg-light rounded p-3 text-start mb-4">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-person-badge fs-1 text-primary"></i>
                        <div>
                            <strong>@Model.Name</strong>
                            <div class="text-muted small">@Model.Email</div>
                            <div class="text-muted small">@Model.Phone</div>
                            <span class="badge bg-primary mt-1">@Model.Specialties</span>
                        </div>
                    </div>
                </div>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-flex justify-content-between gap-3">
                        <a asp-controller="Trainer"
                           asp-action="Index"
                           class="btn btn-outline-secondary flex-fill">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-danger flex-fill">
                            <i class="bi bi-trash me-2"></i>Yes, Delete
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>