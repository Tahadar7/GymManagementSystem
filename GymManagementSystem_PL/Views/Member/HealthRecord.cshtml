@model HealthRecordViewModel
@{
    ViewData["Title"] = "Health Record";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">

                <div class="card-header bg-primary text-white text-center py-4">
                    <h3 class="mb-0">
                        <i class="bi bi-heart-pulse me-2"></i>Health Record
                    </h3>
                </div>

                <div class="card-body p-4">
                    <div class="row g-4">

                        <div class="col-md-6">
                            <div class="card border-0 bg-light p-4 h-100">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="bg-primary rounded-circle p-2 me-3"
                                         style="width:40px; height:40px; display:flex; align-items:center; justify-content:center;">
                                        <span class="text-white fw-bold">H</span>
                                    </div>
                                    <h6 class="text-muted mb-0">Height</h6>
                                </div>
                                <h4 class="text-primary mb-0">
                                    @Model.Height <small class="text-muted">cm</small>
                                </h4>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card border-0 bg-light p-4 h-100">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="bg-primary rounded-circle p-2 me-3"
                                         style="width:40px; height:40px; display:flex; align-items:center; justify-content:center;">
                                        <span class="text-white fw-bold">W</span>
                                    </div>
                                    <h6 class="text-muted mb-0">Weight</h6>
                                </div>
                                <h4 class="text-primary mb-0">
                                    @Model.Weight <small class="text-muted">kg</small>
                                </h4>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card border-0 bg-light p-4 h-100">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="bg-danger rounded-circle p-2 me-3"
                                         style="width:40px; height:40px; display:flex; align-items:center; justify-content:center;">
                                        <span class="text-white fw-bold">B</span>
                                    </div>
                                    <h6 class="text-muted mb-0">Blood Type</h6>
                                </div>
                                <h4 class="text-danger mb-0">@Model.BloodType</h4>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card border-0 bg-light p-4 h-100">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="bg-warning rounded-circle p-2 me-3"
                                         style="width:40px; height:40px; display:flex; align-items:center; justify-content:center;">
                                        <span class="text-white fw-bold">N</span>
                                    </div>
                                    <h6 class="text-muted mb-0">Note</h6>
                                </div>
                                <p class="mb-0">@(Model.Note ?? "No notes on record")</p>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="card-footer bg-white border-0 px-4 pb-4">
                    <a asp-controller="Member"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Back to List
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>