@model CreateMemberViewModel
@{
    ViewData["Title"] = "Add Member";
}

<div class="container mt-4">
    <header class="mb-4">
        <h3 class="fw-bold">Add Member</h3>
    </header>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="alert alert-danger small" style="display:none"></div>

        <ul class="nav nav-tabs mb-4" id="createMemberTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active"
                        id="member-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#member-info"
                        type="button"
                        role="tab">
                    <i class="bi bi-person me-1"></i>Member Info
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link"
                        id="health-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#health-info"
                        type="button"
                        role="tab">
                    <i class="bi bi-heart-pulse me-1"></i>Health Data
                </button>
            </li>
        </ul>

        <div class="tab-content">

            <div class="tab-pane fade show active" id="member-info" role="tabpanel">

                <h5 class="fw-bold text-primary mb-3">Personal Information</h5>
                <hr>

                <div class="row g-3">

                    <div class="col-12">
                        <label asp-for="PhotoFile" class="form-label">
                            Profile Photo <span class="text-danger">*</span>
                        </label>
                        <input asp-for="PhotoFile"
                               type="file"
                               class="form-control"
                               accept="image/*"
                               id="photoInput" />
                        <span asp-validation-for="PhotoFile" class="text-danger small"></span>
                        <small class="text-muted">Max 5MB. Allowed: JPG, JPEG, PNG</small>
                        <div class="mt-2">
                            <img id="photoPreview"
                                 src="#"
                                 alt="Photo Preview"
                                 class="img-thumbnail"
                                 style="max-width:150px; display:none;" />
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" type="email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" placeholder="03XXXXXXXXX" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="DateOfBirth" class="form-label"></label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Gender" class="form-label"></label>
                        <select asp-for="Gender"
                                asp-items="Html.GetEnumSelectList<Gender>()"
                                class="form-select">
                            <option value="">-- Select Gender --</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>

                </div>

                <h5 class="fw-bold text-primary mt-4 mb-3">Address Information</h5>
                <hr>

                <div class="row g-3">

                    <div class="col-12 col-md-4">
                        <label asp-for="BuildingNumber" class="form-label"></label>
                        <input asp-for="BuildingNumber" class="form-control" />
                        <span asp-validation-for="BuildingNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="Street" class="form-label"></label>
                        <input asp-for="Street" class="form-control" />
                        <span asp-validation-for="Street" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>

                </div>
            </div>

            <div class="tab-pane fade" id="health-info" role="tabpanel">

                <h5 class="fw-bold text-primary mb-3">Health Information</h5>
                <hr>

                <div class="row g-3">

                    <div class="col-12 col-md-6">
                        <label asp-for="HealthRecord.Height" class="form-label"></label>
                        <input asp-for="HealthRecord.Height" class="form-control" placeholder="e.g. 175" />
                        <span asp-validation-for="HealthRecord.Height" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="HealthRecord.Weight" class="form-label"></label>
                        <input asp-for="HealthRecord.Weight" class="form-control" placeholder="e.g. 70" />
                        <span asp-validation-for="HealthRecord.Weight" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="HealthRecord.BloodType" class="form-label"></label>
                        <select asp-for="HealthRecord.BloodType" class="form-select">
                            <option value="">-- Select Blood Type --</option>
                            <option>A+</option>
                            <option>A-</option>
                            <option>B+</option>
                            <option>B-</option>
                            <option>O+</option>
                            <option>O-</option>
                            <option>AB+</option>
                            <option>AB-</option>
                        </select>
                        <span asp-validation-for="HealthRecord.BloodType" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="HealthRecord.Note" class="form-label"></label>
                        <input asp-for="HealthRecord.Note" class="form-control" placeholder="Optional notes" />
                    </div>

                </div>
            </div>

        </div>

        <div class="d-flex justify-content-end gap-3 mt-4">
            <a asp-controller="Member"
               asp-action="Index"
               class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left me-2"></i>Back
            </a>
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-plus-circle me-2"></i>Add Member
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // preview photo onbeforeinput upload
        document.getElementById('photoInput').addEventListener('change', function (e) {
            var file = e.target.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    var preview = document.getElementById('photoPreview');
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}