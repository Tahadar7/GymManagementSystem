@model IEnumerable<MemberViewModel>
@{
    ViewData["Title"] = "Members";
}

<partial name="_AlertMessages" />

<div class="container">
    <header class="d-flex justify-content-between align-items-center mt-5 mb-4">
        <h3 class="fw-bold">Members</h3>
        <a asp-controller="Member" asp-action="Create"
           class="btn btn-primary fw-medium rounded-pill px-4 py-2">
            <i class="bi bi-plus-circle me-2"></i>Add Member
        </a>
    </header>

    @if (Model is not null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-borderless align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Photo</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Gender</th>
                        <th>Phone</th>
                        <th>Plan</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model)
                    {
                        <tr>
                            <td>
                                @if (string.IsNullOrEmpty(member.Photo))
                                {
                                    <img src="~/images/user.jpg"
                                         alt="Default Avatar"
                                         class="rounded-circle"
                                         style="width:40px; height:40px; object-fit:cover;" />
                                }
                                else
                                {
                                    <img src="~/images/Members/@member.Photo"
                                         alt="@member.Name"
                                         class="rounded-circle"
                                         style="width:40px; height:40px; object-fit:cover;" />
                                }
                            </td>
                            <td>@member.Name</td>
                            <td>@member.Email</td>
                            <td>@member.Gender</td>
                            <td>@member.Phone</td>
                            <td>
                                @if (member.PlanName is not null)
                                {
                                    <span class="badge bg-success">@member.PlanName</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No Plan</span>
                                }
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                            type="button"
                                            data-bs-toggle="dropdown">
                                        Actions
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a asp-controller="Member"
                                               asp-action="Details"
                                               asp-route-id="@member.Id"
                                               class="dropdown-item">
                                                <i class="bi bi-person-lines-fill me-2"></i>View Details
                                            </a>
                                        </li>
                                        <li>
                                            <a asp-controller="Member"
                                               asp-action="HealthRecord"
                                               asp-route-id="@member.Id"
                                               class="dropdown-item">
                                                <i class="bi bi-heart-pulse me-2"></i>Health Record
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a asp-controller="Member"
                                               asp-action="Edit"
                                               asp-route-id="@member.Id"
                                               class="dropdown-item">
                                                <i class="bi bi-pencil me-2"></i>Edit
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a asp-controller="Member"
                                               asp-action="Delete"
                                               asp-route-id="@member.Id"
                                               class="dropdown-item text-danger">
                                                <i class="bi bi-trash me-2"></i>Delete
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-person-workspace display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Members Yet</h4>
            <p class="text-muted">Add your first member to get started.</p>
            <a asp-controller="Member" asp-action="Create" class="btn btn-primary mt-2">
                <i class="bi bi-plus-circle me-2"></i>Add Member
            </a>
        </div>
    }
</div>