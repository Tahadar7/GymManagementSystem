@model IEnumerable<PlanViewModel>
@{
    ViewData["Title"] = "Assign Plan";
}

<div class="container mt-4">
    <header class="mb-4">
        <h3 class="fw-bold">Assign Plan</h3>
        <p class="text-muted">
            Select a plan for <strong>@ViewBag.MemberName</strong>
        </p>
    </header>

    @if (Model is not null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var plan in Model)
            {
                <div class="col-12 col-md-4">
                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-header bg-primary text-white text-center py-3">
                            <i class="bi bi-award fs-3 mb-1 d-block"></i>
                            <h5 class="mb-0">@plan.Name</h5>
                        </div>

                        <div class="card-body text-center">
                            <div class="display-5 fw-bold text-primary mb-1">
                                @plan.Price.ToString("N0")
                            </div>
                            <small class="text-muted">PKR</small>
                            <hr>
                            <p class="text-muted mb-1">
                                <i class="bi bi-calendar-check me-1"></i>
                                <strong>Duration:</strong> @plan.DurationDays days
                            </p>
                            <p class="small text-muted">@plan.Description</p>
                        </div>

                        <div class="card-footer bg-white border-0 pb-3 px-3">
                            <form asp-action="AssignPlan"
                                  asp-route-id="@ViewBag.MemberId"
                                  method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="planId" value="@plan.Id" />
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-check-circle me-2"></i>Assign This Plan
                                </button>
                            </form>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Active Plans Available</h4>
            <p class="text-muted">Create and activate a plan first.</p>
            <a asp-controller="Plan" asp-action="Create"
               class="btn btn-primary mt-2">
                <i class="bi bi-plus-circle me-2"></i>Create Plan
            </a>
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Member" asp-action="Details"
           asp-route-id="@ViewBag.MemberId"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to Member
        </a>
    </div>
</div>