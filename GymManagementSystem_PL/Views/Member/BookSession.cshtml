@model IEnumerable<SessionViewModel>
@{
    ViewData["Title"] = "Book Session";
}

<div class="container mt-4">
    <header class="mb-4">
        <h3 class="fw-bold">Book Session</h3>
        <p class="text-muted">
            Select a session for <strong>@ViewBag.MemberName</strong>
        </p>
    </header>

    @if (Model is not null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var session in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-header bg-primary text-white py-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="bi bi-calendar-event me-2"></i>@session.CategoryName
                                </h5>
                                <span class="badge bg-light text-primary">Upcoming</span>
                            </div>
                        </div>

                        <div class="card-body">
                            <p class="text-muted small mb-3">@session.Description</p>

                            <div class="mb-2">
                                <i class="bi bi-person-badge text-primary me-1"></i>
                                <strong>Trainer:</strong> @session.TrainerName
                            </div>
                            <div class="mb-2">
                                <i class="bi bi-calendar3 text-primary me-1"></i>
                                <strong>Date:</strong> @session.DateDisplay
                            </div>
                            <div class="mb-2">
                                <i class="bi bi-clock text-primary me-1"></i>
                                <strong>Time:</strong> @session.TimeRangeDisplay
                            </div>
                            <div class="mb-2">
                                <i class="bi bi-hourglass-split text-primary me-1"></i>
                                <strong>Duration:</strong> @session.DurationDisplay
                            </div>
                            <div class="mb-2">
                                <i class="bi bi-people text-primary me-1"></i>
                                <strong>Available Slots:</strong>
                                <span class="fw-bold @(session.AvailableSlots <= 3 ? "text-danger" : "text-success")">
                                    @session.AvailableSlots
                                </span>
                                / @session.Capacity
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0 pb-3 px-3">
                            <form asp-action="BookSession"
                                  asp-route-id="@ViewBag.MemberId"
                                  method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="sessionId" value="@session.Id" />
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-calendar-plus me-2"></i>Book This Session
                                </button>
                            </form>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Available Sessions</h4>
            <p class="text-muted">
                All upcoming sessions are full or no sessions have been created yet.
            </p>
            <a asp-controller="Session" asp-action="Create"
               class="btn btn-primary mt-2">
                <i class="bi bi-plus-circle me-2"></i>Create Session
            </a>
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Member" asp-action="Details"
           asp-route-id="@ViewBag.MemberId"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to Member
        </a>
    </div>
</div>