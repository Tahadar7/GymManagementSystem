@model SessionViewModel
@{
    ViewData["Title"] = "Delete Session";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 text-center p-4">

                <div class="mb-3" style="font-size:60px;">⚠️</div>

                <h4 class="fw-bold text-danger mb-2">Delete Session</h4>

                <p class="text-muted mb-1">
                    Are you sure you want to delete this session?
                </p>

                <div class="alert alert-warning text-start mt-3" role="alert">
                    <strong>Warning:</strong> This action cannot be undone.
                    Deletion is blocked if the session has already started or has existing bookings.
                </div>

                <!-- Session summary so admin knows what they're deleting -->
                <div class="bg-light rounded p-3 text-start mb-4">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <i class="bi bi-calendar-event fs-2
                            @(Model.Status == "Ongoing" ? "text-success" :
                              Model.Status == "Upcoming" ? "text-primary" : "text-secondary")"></i>
                        <div>
                            <strong>@Model.CategoryName</strong>
                            <span class="badge ms-2
                                @(Model.Status == "Ongoing" ? "bg-success" :
                                  Model.Status == "Upcoming" ? "bg-primary" : "bg-secondary")">
                                @Model.Status
                            </span>
                            <div class="text-muted small">Trainer: @Model.TrainerName</div>
                            <div class="text-muted small">@Model.DateDisplay — @Model.TimeRangeDisplay</div>
                            <div class="text-muted small">
                                @Model.AvailableSlots / @Model.Capacity slots available
                            </div>
                        </div>
                    </div>
                </div>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-flex justify-content-between gap-3">
                        <a asp-controller="Session"
                           asp-action="Index"
                           class="btn btn-outline-secondary flex-fill">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-danger flex-fill">
                            <i class="bi bi-trash me-2"></i>Yes, Delete
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>