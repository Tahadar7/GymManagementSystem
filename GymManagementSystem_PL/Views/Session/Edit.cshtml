@model EditSessionViewModel
@{
    ViewData["Title"] = "Edit Session";
}

<div class="container mt-4">
    <header class="mb-4">
        <h3 class="fw-bold">Edit Session</h3>
        <p class="text-muted">Update session information</p>
    </header>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow border-0">
                    <div class="card-body p-4">

                        <div asp-validation-summary="All" class="alert alert-danger small"></div>

                        <h5 class="fw-bold text-primary mb-3">Session Information</h5>
                        <hr>

                        <div class="row g-3 mb-4">

                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label fw-semibold">
                                    Category <span class="text-danger">*</span>
                                </label>
                                <select asp-for="CategoryId"
                                        asp-items="@ViewBag.Categories"
                                        class="form-select">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TrainerId" class="form-label fw-semibold">
                                    Trainer <span class="text-danger">*</span>
                                </label>
                                <select asp-for="TrainerId"
                                        asp-items="@ViewBag.Trainers"
                                        class="form-select">
                                    <option value="">-- Select Trainer --</option>
                                </select>
                                <span asp-validation-for="TrainerId" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold">
                                    Description <span class="text-danger">*</span>
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Capacity" class="form-label fw-semibold">
                                    Capacity <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Capacity"
                                       type="number"
                                       class="form-control"
                                       min="1"
                                       max="25" />
                                <span asp-validation-for="Capacity" class="text-danger small d-block"></span>
                            </div>

                        </div>

                        <h5 class="fw-bold text-primary mb-3">Date & Time</h5>
                        <hr>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label fw-semibold">
                                    Start Date & Time <span class="text-danger">*</span>
                                </label>
                                <input asp-for="StartDate"
                                       type="datetime-local"
                                       class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label fw-semibold">
                                    End Date & Time <span class="text-danger">*</span>
                                </label>
                                <input asp-for="EndDate"
                                       type="datetime-local"
                                       class="form-control" />
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>

                        </div>

                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a asp-controller="Session"
                               asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                <i class="bi bi-arrow-left me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle me-2"></i>Update Session
                            </button>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}