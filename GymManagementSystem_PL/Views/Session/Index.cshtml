@model IEnumerable<SessionViewModel>
@{
    ViewData["Title"] = "Sessions";
}

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container">
    <header class="d-flex justify-content-between align-items-center mt-5 mb-4">
        <div>
            <h2 class="fw-bold mb-0">Training Sessions</h2>
            <p class="text-muted">Manage gym training sessions and classes</p>
        </div>
        <a asp-controller="Session" asp-action="Create"
           class="btn btn-primary fw-medium rounded-pill px-4 py-2">
            <i class="bi bi-plus-circle me-2"></i>Add Session
        </a>
    </header>

    @if (Model is not null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var session in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-header text-white py-3
                            @(session.Status == "Ongoing" ? "bg-success" :
                               session.Status == "Upcoming" ? "bg-primary" : "bg-secondary")">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="bi bi-calendar-event me-2"></i>@session.CategoryName
                                </h5>
                                <span class="badge bg-light text-dark">@session.Status</span>
                            </div>
                        </div>

                        <div class="card-body">
                            <p class="text-muted mb-3">@session.Description</p>

                            <div class="mb-2">
                                <i class="bi bi-person-circle text-primary me-2"></i>
                                <strong>Trainer:</strong> @session.TrainerName
                            </div>
                            <div class="mb-2">
                                <i class="bi bi-calendar3 text-primary me-2"></i>
                                <strong>Date:</strong> @session.DateDisplay
                            </div>
                            <div class="mb-2">
                                <i class="bi bi-clock text-primary me-2"></i>
                                <strong>Time:</strong> @session.TimeRangeDisplay
                            </div>
                            <div class="mb-2">
                                <i class="bi bi-hourglass-split text-primary me-2"></i>
                                <strong>Duration:</strong>
                                @session.Duration.Hours h @session.Duration.Minutes m
                            </div>
                            <div class="mb-2">
                                <i class="bi bi-people text-primary me-2"></i>
                                <strong>Slots:</strong>
                                @session.AvailableSlots / @session.Capacity available
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0">
                            <div class="d-grid gap-2">
                                <a asp-controller="Session"
                                   asp-action="Details"
                                   asp-route-id="@session.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye me-1"></i>View Details
                                </a>
                                <div class="d-flex gap-2">
                                    <a asp-controller="Session"
                                       asp-action="Edit"
                                       asp-route-id="@session.Id"
                                       class="btn btn-outline-secondary btn-sm flex-fill">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    <a asp-controller="Session"
                                       asp-action="Delete"
                                       asp-route-id="@session.Id"
                                       class="btn btn-outline-danger btn-sm flex-fill">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Sessions Yet</h4>
            <p class="text-muted">Create your first training session to get started.</p>
            <a asp-controller="Session" asp-action="Create" class="btn btn-primary mt-2">
                <i class="bi bi-plus-circle me-2"></i>Add Session
            </a>
        </div>
    }
</div>