@model SessionViewModel
@{
    ViewData["Title"] = "Session Details";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">

                <div class="card-header text-white text-center py-4
                    @(Model.Status == "Ongoing" ? "bg-success" :
                       Model.Status == "Upcoming" ? "bg-primary" : "bg-secondary")">
                    <i class="bi bi-calendar-event display-4 mb-3"></i>
                    <h2 class="mb-2">@Model.CategoryName</h2>
                    <span class="badge bg-light text-dark fs-6">@Model.Status</span>
                </div>

                <div class="card-body p-4">

                    <div class="mb-4 p-3 bg-light rounded">
                        <h6 class="text-primary mb-2">
                            <i class="bi bi-file-text me-2"></i>Description
                        </h6>
                        <p class="mb-0">@Model.Description</p>
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <div class="p-3 border rounded">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-person-circle text-primary fs-3 me-3"></i>
                                    <div>
                                        <small class="text-muted d-block">Trainer</small>
                                        <strong>@Model.TrainerName</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 border rounded">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-people text-primary fs-3 me-3"></i>
                                    <div>
                                        <small class="text-muted d-block">Available Slots</small>
                                        <strong>@Model.AvailableSlots / @Model.Capacity</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 border rounded">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-calendar-check text-primary fs-3 me-3"></i>
                                    <div>
                                        <small class="text-muted d-block">Start</small>
                                        <strong>@Model.StartDate.ToString("MMM dd, yyyy hh:mm tt")</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 border rounded">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-calendar-x text-primary fs-3 me-3"></i>
                                    <div>
                                        <small class="text-muted d-block">End</small>
                                        <strong>@Model.EndDate.ToString("MMM dd, yyyy hh:mm tt")</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="p-3 border rounded bg-light">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-hourglass-split text-primary fs-3 me-3"></i>
                                    <div>
                                        <small class="text-muted d-block">Duration</small>
                                        <strong class="fs-5">
                                            @Model.Duration.Hours hours @Model.Duration.Minutes minutes
                                        </strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="card-footer bg-white border-0 px-4 pb-4 d-flex gap-2">
                    <a asp-controller="Session"
                       asp-action="Index"
                       class="btn btn-outline-secondary flex-fill">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>
                    <a asp-controller="Session"
                       asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary flex-fill">
                        <i class="bi bi-pencil me-2"></i>Edit
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>