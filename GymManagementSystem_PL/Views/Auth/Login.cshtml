@model LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Gym Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: #f8f9fa;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .login-wrapper {
                display: grid;
                grid-template-columns: 1fr 1fr;
                min-height: 100vh;
                width: 100%;
            }

            /* Left side - form */
            .form-section {
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: 60px 50px;
                background: #ffffff;
            }

            .logo-section {
                margin-bottom: 40px;
            }

            .logo-icon {
                width: 55px;
                height: 55px;
                background: linear-gradient(135deg, #0033cc, #0055ff);
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 12px;
            }

            .logo-icon i {
                color: white;
                font-size: 28px;
            }

            .brand-name {
                font-size: 22px;
                font-weight: 700;
                color: #0033cc;
                margin: 0;
            }

            .brand-subtitle {
                color: #888;
                font-size: 13px;
                margin: 0;
            }

            .login-title {
                font-size: 28px;
                font-weight: 700;
                color: #222;
                margin-bottom: 6px;
            }

            .login-subtitle {
                color: #888;
                margin-bottom: 32px;
                font-size: 14px;
            }

            .form-floating {
                margin-bottom: 16px;
            }

            .form-control {
                border: 1.5px solid #e0e0e0;
                border-radius: 8px;
                padding: 14px 16px;
                font-size: 15px;
                transition: border-color 0.2s;
            }

            .form-control:focus {
                border-color: #0033cc;
                box-shadow: 0 0 0 3px rgba(0, 51, 204, 0.1);
            }

            .btn-login {
                width: 100%;
                padding: 14px;
                background: linear-gradient(135deg, #0033cc, #0055ff);
                color: white;
                border: none;
                border-radius: 8px;
                font-size: 16px;
                font-weight: 600;
                margin-top: 20px;
                cursor: pointer;
                transition: all 0.3s;
            }

            .btn-login:hover {
                background: linear-gradient(135deg, #0028a3, #0044dd);
                transform: translateY(-1px);
                box-shadow: 0 4px 15px rgba(0, 51, 204, 0.3);
            }

            .register-link {
                text-align: center;
                margin-top: 24px;
                font-size: 14px;
                color: #666;
            }

            .register-link a {
                color: #0033cc;
                font-weight: 600;
                text-decoration: none;
            }

            .register-link a:hover {
                text-decoration: underline;
            }

            /* Right side - info panel */
            .info-section {
                background: linear-gradient(135deg, #0033cc 0%, #001a6e 100%);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 60px 50px;
                color: white;
            }

            .info-content {
                text-align: center;
                max-width: 400px;
            }

            .gym-icon {
                font-size: 80px;
                margin-bottom: 30px;
            }

            .info-title {
                font-size: 32px;
                font-weight: 700;
                margin-bottom: 20px;
                line-height: 1.3;
            }

            .info-title span {
                color: #ffd700;
            }

            .info-description {
                font-size: 15px;
                color: rgba(255,255,255,0.8);
                line-height: 1.7;
                margin-bottom: 40px;
            }

            .stats-grid {
                display: flex;
                gap: 30px;
                justify-content: center;
            }

            .stat-item {
                display: flex;
                flex-direction: column;
                align-items: center;
            }

            .stat-number {
                font-size: 28px;
                font-weight: 700;
                color: #ffd700;
            }

            .stat-label {
                font-size: 13px;
                color: rgba(255,255,255,0.7);
                margin-top: 4px;
            }

            @@media (max-width: 768px) {
                .login-wrapper {
                    grid-template-columns: 1fr;
                }
                .info-section {
                    display: none;
                }
            }
    </style>
</head>
<body>
    <div class="login-wrapper">

        <!-- Left Side - Login Form -->
        <div class="form-section">
            <div class="logo-section">
                <div class="logo-icon">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>
                <h1 class="brand-name">Gym Management</h1>
                <p class="brand-subtitle">Admin Portal</p>
            </div>

            <h2 class="login-title">Welcome Back</h2>
            <p class="login-subtitle">Please sign in to your account</p>

            <form asp-action="Login" asp-controller="Auth" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Email"
                           class="form-control"
                           id="email"
                           placeholder="admin@example.com"
                           autocomplete="email" />
                    <label for="email">
                        <i class="bi bi-envelope me-2"></i>Email Address
                    </label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Password"
                           class="form-control"
                           id="password"
                           placeholder="Password"
                           autocomplete="current-password" />
                    <label for="password">
                        <i class="bi bi-lock-fill me-2"></i>Password
                    </label>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-2">
                    <input asp-for="RememberMe" class="form-check-input" id="rememberMe" />
                    <label class="form-check-label" for="rememberMe">
                        Remember me
                    </label>
                </div>

                <button type="submit" class="btn-login">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </button>
            </form>

            <div class="register-link">
                Don't have an account?
                <a asp-action="Register" asp-controller="Auth">Create one here</a>
            </div>
        </div>

        <!-- Right Side - Info Panel -->
        <div class="info-section">
            <div class="info-content">
                <div class="gym-icon">💪</div>
                <h2 class="info-title">
                    Your body can <span>stand</span><br>
                    almost anything
                </h2>
                <p class="info-description">
                    It's your mind that needs convincing. Push past your limits,
                    stay committed, and watch as your body transforms into a
                    powerhouse of strength and resilience.
                </p>
                <div class="stats-grid">
                    <div class="stat-item">
                        <span class="stat-number">500+</span>
                        <span class="stat-label">Members</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">50+</span>
                        <span class="stat-label">Trainers</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">24/7</span>
                        <span class="stat-label">Support</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>