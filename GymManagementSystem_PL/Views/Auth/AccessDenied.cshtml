@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Access Denied";
}

<div style="display:flex; flex-direction:column; gap:20px;">
    <div style="font-size:64px;">🚫</div>
    <h1 style="font-size:42px; font-weight:700; color:#222; line-height:1.2;">
        Access <span style="color:#0033cc;">Denied</span>
    </h1>
    <p style="font-size:15px; color:#666; line-height:1.7;">
        You don't have permission to access this resource.
        Your current account role doesn't grant you access to this section.
    </p>
    <div style="background:#f0f0f0; padding:10px 16px; border-radius:6px;
                font-family:'Courier New',monospace; font-size:13px; color:#444;">
        Error 403 — Forbidden Access
    </div>
    <p style="font-size:15px; color:#666; line-height:1.7;">
        If you believe this is a mistake, please contact the system administrator.
    </p>
    <a asp-action="Index" asp-controller="Home" class="btn-auth"
       style="width:fit-content; text-decoration:none; padding:12px 28px;">
        Return to Home
    </a>
</div>

@section InfoPanel { }