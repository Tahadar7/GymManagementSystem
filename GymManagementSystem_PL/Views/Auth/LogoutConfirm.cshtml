@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Logout";
}

<h2 class="auth-title">Logout</h2>
<p class="auth-subtitle">Are you sure you want to sign out?</p>

<div class="alert alert-warning mt-3">
    <i class="bi bi-exclamation-triangle me-2"></i>
    You will need to sign in again to access the system.
</div>

<form asp-controller="Auth" asp-action="Logout" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn-auth mt-3">
        <i class="bi bi-box-arrow-right me-2"></i>Yes, Logout
    </button>
</form>

<div class="auth-bottom-link mt-3">
    <a asp-controller="Home" asp-action="Index">
        <i class="bi bi-arrow-left me-1"></i>Cancel, go back to Dashboard
    </a>
</div>

@section InfoPanel { }