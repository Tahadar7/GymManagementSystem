@model RegisterViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register - Gym Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: #f8f9fa;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .register-wrapper {
                display: grid;
                grid-template-columns: 1fr 1fr;
                min-height: 100vh;
                width: 100%;
            }

            .form-section {
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: 60px 50px;
                background: #ffffff;
                overflow-y: auto;
            }

            .logo-section {
                margin-bottom: 32px;
            }

            .logo-icon {
                width: 55px;
                height: 55px;
                background: linear-gradient(135deg, #0033cc, #0055ff);
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 12px;
            }

                .logo-icon i {
                    color: white;
                    font-size: 28px;
                }

            .brand-name {
                font-size: 22px;
                font-weight: 700;
                color: #0033cc;
                margin: 0;
            }

            .brand-subtitle {
                color: #888;
                font-size: 13px;
                margin: 0;
            }

            .register-title {
                font-size: 28px;
                font-weight: 700;
                color: #222;
                margin-bottom: 6px;
            }

            .register-subtitle {
                color: #888;
                margin-bottom: 28px;
                font-size: 14px;
            }

            .form-control {
                border: 1.5px solid #e0e0e0;
                border-radius: 8px;
                padding: 12px 16px;
                font-size: 15px;
                transition: border-color 0.2s;
            }

                .form-control:focus {
                    border-color: #0033cc;
                    box-shadow: 0 0 0 3px rgba(0, 51, 204, 0.1);
                }

            .form-label {
                font-size: 14px;
                font-weight: 500;
                color: #444;
                margin-bottom: 6px;
            }

            .btn-register {
                width: 100%;
                padding: 14px;
                background: linear-gradient(135deg, #0033cc, #0055ff);
                color: white;
                border: none;
                border-radius: 8px;
                font-size: 16px;
                font-weight: 600;
                margin-top: 20px;
                cursor: pointer;
                transition: all 0.3s;
            }

                .btn-register:hover {
                    background: linear-gradient(135deg, #0028a3, #0044dd);
                    transform: translateY(-1px);
                    box-shadow: 0 4px 15px rgba(0, 51, 204, 0.3);
                }

            .login-link {
                text-align: center;
                margin-top: 20px;
                font-size: 14px;
                color: #666;
            }

                .login-link a {
                    color: #0033cc;
                    font-weight: 600;
                    text-decoration: none;
                }

                    .login-link a:hover {
                        text-decoration: underline;
                    }

            /* Right side */
            .info-section {
                background: linear-gradient(135deg, #0033cc 0%, #001a6e 100%);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 60px 50px;
                color: white;
            }

            .info-content {
                text-align: center;
                max-width: 400px;
            }

            .gym-icon {
                font-size: 80px;
                margin-bottom: 30px;
            }

            .info-title {
                font-size: 32px;
                font-weight: 700;
                margin-bottom: 20px;
                line-height: 1.3;
            }

                .info-title span {
                    color: #ffd700;
                }

            .info-description {
                font-size: 15px;
                color: rgba(255,255,255,0.8);
                line-height: 1.7;
            }

            @@media (max-width: 768px) {
                .register-wrapper {
                    grid-template-columns: 1fr;
                }

                .info-section {
                    display: none;
                }
            }
    </style>
</head>
<body>
    <div class="register-wrapper">

        <!-- Left Side - Register Form -->
        <div class="form-section">
            <div class="logo-section">
                <div class="logo-icon">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>
                <h1 class="brand-name">Gym Management</h1>
                <p class="brand-subtitle">Admin Portal</p>
            </div>

            <h2 class="register-title">Create Account</h2>
            <p class="register-subtitle">Fill in the details to register a new admin</p>

            <form asp-action="Register" asp-controller="Auth" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FirstName" class="form-label">
                            <i class="bi bi-person me-1"></i>First Name
                        </label>
                        <input asp-for="FirstName"
                               class="form-control"
                               placeholder="Taha" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="LastName" class="form-label">
                            <i class="bi bi-person me-1"></i>Last Name
                        </label>
                        <input asp-for="LastName"
                               class="form-control"
                               placeholder="Dar" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">
                        <i class="bi bi-envelope me-1"></i>Email Address
                    </label>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="admin@example.com"
                           autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">
                        <i class="bi bi-lock me-1"></i>Password
                    </label>
                    <input asp-for="Password"
                           class="form-control"
                           placeholder="Minimum 8 characters"
                           autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">
                        <i class="bi bi-lock-fill me-1"></i>Confirm Password
                    </label>
                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           placeholder="Re-enter your password"
                           autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-register">
                    <i class="bi bi-person-plus me-2"></i>Create Account
                </button>
            </form>

            <div class="login-link">
                Already have an account?
                <a asp-action="Login" asp-controller="Auth">Sign in here</a>
            </div>
        </div>

        <!-- Right Side - Info Panel -->
        <div class="info-section">
            <div class="info-content">
                <div class="gym-icon">🏋️</div>
                <h2 class="info-title">
                    Join the <span>team</span><br>
                    behind the gym
                </h2>
                <p class="info-description">
                    Manage members, trainers, plans, and sessions
                    all from one powerful admin dashboard built
                    for modern gym management.
                </p>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>