@model IEnumerable<PlanViewModel>
@{
    ViewData["Title"] = "Plans";
}

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container">
    <header class="d-flex justify-content-between align-items-center mt-5 mb-4">
        <div>
            <h2 class="fw-bold mb-0">Membership Plans</h2>
            <p class="text-muted">Manage your gym membership packages</p>
        </div>
        <a asp-controller="Plan" asp-action="Create"
           class="btn btn-primary fw-medium rounded-pill px-4 py-2">
            <i class="bi bi-plus-circle me-2"></i>Add Plan
        </a>
    </header>

    @if (Model is not null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var plan in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">

                        <!-- Header color changes based on active/inactive status -->
                        <div class="card-header text-white text-center py-4 @(plan.IsActive ? "bg-primary" : "bg-secondary")">
                            <h4 class="mb-0">@plan.Name</h4>
                            @if (plan.IsActive)
                            {
                                <span class="badge bg-success mt-2">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger mt-2">Inactive</span>
                            }
                        </div>

                        <div class="card-body d-flex flex-column">
                            <!-- Price -->
                            <div class="text-center mb-4">
                                <div class="display-4 fw-bold text-primary">
                                    @plan.Price.ToString("N0")
                                </div>
                                <small class="text-muted">PKR</small>
                            </div>

                            <!-- Plan info -->
                            <div class="mb-3">
                                <p class="text-muted mb-2">
                                    <i class="bi bi-calendar-check text-primary me-2"></i>
                                    <strong>Duration:</strong> @plan.DurationDays days
                                </p>
                                <p class="text-muted mb-1">
                                    <i class="bi bi-file-text text-primary me-2"></i>
                                    <strong>Description:</strong>
                                </p>
                                <p class="small text-muted">@plan.Description</p>
                            </div>

                            <!-- Action buttons -->
                            <div class="mt-auto">
                                <div class="d-grid gap-2">
                                    <a asp-controller="Plan"
                                       asp-action="Details"
                                       asp-route-id="@plan.Id"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-eye me-1"></i>View Details
                                    </a>
                                    <div class="d-flex gap-2">
                                        <a asp-controller="Plan"
                                           asp-action="Edit"
                                           asp-route-id="@plan.Id"
                                           class="btn btn-outline-secondary btn-sm flex-fill">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </a>

                                        <form asp-controller="Plan"
                                              asp-action="ToggleStatus"
                                              asp-route-id="@plan.Id"
                                              method="post"
                                              class="flex-fill">
                                            @Html.AntiForgeryToken()
                                            @if (plan.IsActive)
                                            {
                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm w-100">
                                                    <i class="bi bi-x-circle me-1"></i>Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-outline-success btn-sm w-100">
                                                    <i class="bi bi-check-circle me-1"></i>Activate
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Plans Yet</h4>
            <p class="text-muted">Add your first membership plan to get started.</p>
            <a asp-controller="Plan" asp-action="Create" class="btn btn-primary mt-2">
                <i class="bi bi-plus-circle me-2"></i>Add Plan
            </a>
        </div>
    }
</div>