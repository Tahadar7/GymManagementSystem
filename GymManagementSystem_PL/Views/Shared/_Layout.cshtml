<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gym Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1;
        }

        .navbar-nav .nav-link.active {
            color: #fff !important;
            font-weight: 700;
            border-bottom: 2px solid #fff;
        }

        .footer {
            background-color: #1a1a2e;
            color: rgba(255,255,255,0.7);
            padding: 20px 0;
            font-size: 14px;
            margin-top: auto;
        }
    </style>
</head>
<body>

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">

            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-lightning-charge-fill me-2"></i>Gym Management
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Home" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">
                            <i class="bi bi-speedometer2 me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Member" ? "active" : "")"
                           asp-controller="Member" asp-action="Index">
                            <i class="bi bi-people me-1"></i>Members
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Trainer" ? "active" : "")"
                           asp-controller="Trainer" asp-action="Index">
                            <i class="bi bi-person-badge me-1"></i>Trainers
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Plan" ? "active" : "")"
                           asp-controller="Plan" asp-action="Index">
                            <i class="bi bi-award me-1"></i>Plans
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Session" ? "active" : "")"
                           asp-controller="Session" asp-action="Index">
                            <i class="bi bi-calendar-event me-1"></i>Sessions
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Category" ? "active" : "")"
                           asp-controller="Category" asp-action="Index">
                            <i class="bi bi-tag me-1"></i>Categories
                        </a>
                    </li>
                </ul>

                @if (User.Identity!.IsAuthenticated)
                {
                    <ul class="navbar-nav ms-auto align-items-center">

                        @* Add Admin button — SuperAdmin only *@
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item me-2">
                                <a asp-controller="Auth" asp-action="Register"
                                   class="btn btn-warning btn-sm fw-semibold">
                                    <i class="bi bi-person-plus me-1"></i>Add Admin
                                </a>
                            </li>
                        }

                        <li class="nav-item me-3">
                            <span class="text-white-50 small">
                                <i class="bi bi-person-circle me-1"></i>
                                @User.Identity.Name
                                @if (User.IsInRole("SuperAdmin"))
                                {
                                    <span class="badge bg-warning text-dark ms-1">SuperAdmin</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-primary ms-1">Admin</span>
                                }
                            </span>
                        </li>

                     <li class="nav-item">
    <a asp-controller="Auth" asp-action="LogoutConfirm"
       class="btn btn-outline-light btn-sm">
        <i class="bi bi-box-arrow-right me-1"></i>Logout
    </a>
</li>

                    </ul>
                }

            </div>
        </div>
    </nav>

    <div class="container mt-3">
        <partial name="_AlertMessages" />
    </div>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <strong class="text-white">
                        <i class="bi bi-lightning-charge-fill me-1"></i>Gym Management System
                    </strong>
                    <span class="ms-2">© @DateTime.Now.Year All rights reserved.</span>
                </div>
                <div class="col-md-6 text-md-end">
                    <span>Built with ASP.NET Core MVC</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>