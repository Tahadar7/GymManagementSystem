
<div class="info-section">
    <div style="text-align:center; max-width:400px;">

        <div style="font-size:80px; margin-bottom:30px;">
            @(ViewData["PanelIcon"] ?? "💪")
        </div>

        <h2 style="font-size:32px; font-weight:700; margin-bottom:20px;
                   line-height:1.3; color:white;">
            @Html.Raw(ViewData["PanelTitle"]
                ?? "Your body can <span style='color:#ffd700'>stand</span><br>almost anything")
        </h2>

        <p style="font-size:15px; color:rgba(255,255,255,0.8);
                  line-height:1.7; margin-bottom:40px;">
            @(ViewData["PanelDescription"]
                ?? "It's your mind that needs convincing. Push past your limits and watch your body transform.")
        </p>

        <div style="display:flex; gap:30px; justify-content:center;">
            <div style="display:flex; flex-direction:column; align-items:center;">
                <span style="font-size:28px; font-weight:700; color:#ffd700;">500+</span>
                <span style="font-size:13px; color:rgba(255,255,255,0.7); margin-top:4px;">Members</span>
            </div>
            <div style="display:flex; flex-direction:column; align-items:center;">
                <span style="font-size:28px; font-weight:700; color:#ffd700;">50+</span>
                <span style="font-size:13px; color:rgba(255,255,255,0.7); margin-top:4px;">Trainers</span>
            </div>
            <div style="display:flex; flex-direction:column; align-items:center;">
                <span style="font-size:28px; font-weight:700; color:#ffd700;">24/7</span>
                <span style="font-size:13px; color:rgba(255,255,255,0.7); margin-top:4px;">Support</span>
            </div>
        </div>
    </div>
</div>

<style>
    .info-section {
        background: linear-gradient(135deg, #0033cc 0%, #001a6e 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 50px;
        color: white;
    }
</style>